rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function correoPermitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@{{DOMINIO_REGEX}}');
    }

    function tieneRegistro() {
      return correoPermitido()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function usuarioActual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function activoConRol(roles) {
      return tieneRegistro() && usuarioActual().activo == true && usuarioActual().rol in roles;
    }

    function puedeLeer() { return activoConRol(['admin', 'capturista', 'consulta']); }
    function puedeCapturar() { return activoConRol(['admin', 'capturista']); }
    function esAdmin() { return activoConRol(['admin']); }

    match /usuarios/{uid} {
      allow get: if correoPermitido() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      allow create: if correoPermitido()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'rol', 'activo'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'consulta'
        && request.resource.data.activo == true;
      allow update: if esAdmin();
      // Revocar es activo: false; borrar re-registraria la cuenta como consulta activa
      allow delete: if false;
    }

    match /catalogos/{id} {
      allow read: if puedeLeer();
      allow write: if esAdmin();
    }

    match /configuracion/{id} {
      allow read: if puedeLeer();
      allow write: if esAdmin();
    }

    // Un documento por archivo; la forma es inmutable y el tope de 10 por registro se refuerza en el cliente.
    match /adjuntos/{id} {
      function adjuntoValido(d) {
        return d.keys().hasOnly([
            'colaborador_id', 'modulo', 'registro_id', 'archivo_id', 'nombre', 'tipo', 'tamano', 'subido_por', 'subido_en'
          ])
          && d.keys().hasAll([
            'colaborador_id', 'modulo', 'registro_id', 'archivo_id', 'nombre', 'tipo', 'tamano', 'subido_por', 'subido_en'
          ])
          && d.colaborador_id is string && d.colaborador_id.size() > 0 && d.colaborador_id.size() <= 128
          && d.modulo in ['accidentes', 'capacitaciones']
          && d.registro_id is string && d.registro_id.size() > 0 && d.registro_id.size() <= 128
          && d.archivo_id is string && d.archivo_id.matches('[0-9a-f]{32}')
          && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 120
          && d.tipo in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        ]
          && d.tamano is number && d.tamano > 0 && d.tamano <= 10485760
          && d.subido_por == request.auth.uid
          && d.subido_en == request.time;
      }

      allow read: if puedeLeer();
      allow create: if puedeCapturar() && adjuntoValido(request.resource.data);
      allow update: if false;
      allow delete: if puedeCapturar();
    }

    function esOperativa(c) {
      return c in [
        'colaboradores', 'capacitaciones', 'entregas_uniforme', 'entregas_epp',
        'accidentes', 'oficinas_equipo', 'vehiculos', 'indicadores_mensuales'
      ];
    }

    // Los colaboradores se desactivan con activo: false, nunca se borran.
    match /{coleccion}/{id} {
      allow read: if esOperativa(coleccion) && puedeLeer();
      allow create, update: if esOperativa(coleccion) && puedeCapturar();
      allow delete: if coleccion != 'colaboradores' && esOperativa(coleccion) && esAdmin();
    }
  }
}
