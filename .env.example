# Configuración web de la app de Firebase (consola > Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Id de la base de Firestore con nombre de esta app; nunca (default)
NEXT_PUBLIC_FIRESTORE_DATABASE=
# Dominio de correo permitido para entrar, en minúsculas y sin @ (ej. empresa.com)
NEXT_PUBLIC_DOMINIO_PERMITIDO=
# Nombre del bucket de Storage (sin gs://); se usa al adjuntar archivos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Origen público de la app (https://...); solo lo lee pnpm config:firebase para generar el CORS del bucket
ORIGEN_APP=
