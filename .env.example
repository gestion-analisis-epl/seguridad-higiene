# Configuración web de la app de Firebase (consola > Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Id de la base de Firestore con nombre de esta app; nunca (default)
NEXT_PUBLIC_FIRESTORE_DATABASE=
# Dominio de correo permitido para entrar, en minúsculas y sin @ (ej. empresa.com)
NEXT_PUBLIC_DOMINIO_PERMITIDO=
# Nombre del bucket de Storage (sin gs://); se usa al adjuntar y descargar archivos
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Hoja de Google Sheets con los colaboradores (solo servidor); si la pestaña queda vacía se usa "Colaboradores"
COLABORADORES_SHEET_ID=
COLABORADORES_SHEET_TAB=
# Pestaña de colaboradores inactivos (opcional): se ofrecen al enlazar y se marcan inactivos
COLABORADORES_SHEET_TAB_INACTIVOS=
# Pestaña con las entregas de uniforme, EPP y equipo; las llena un flujo externo
COLABORADORES_SHEET_TAB_UNIFORMES=
# JSON completo de la cuenta de servicio en una sola línea (solo local; en App Hosting no hace falta). La hoja se comparte como lector con su client_email
FIREBASE_SERVICE_ACCOUNT_JSON=
# Secreto con el que Cloud Scheduler llama a /api/colaboradores/sincronizar-cron; sin él el endpoint queda cerrado
CRON_SECRET=
