rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Dominios de correo autorizados; agregar aquí los que hagan falta.
    function dominiosPermitidos() { return ['grupoepl.com.mx']; }

    function correoPermitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.split('@')[1] in dominiosPermitidos();
    }

    // Sin leer Firestore (no requiere permisos IAM): el rol se exige en la app y en las reglas de Firestore.
    function puedeLeer() { return correoPermitido(); }
    function puedeCapturar() { return correoPermitido(); }

    function tipoPermitido() {
      return request.resource.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-powerpoint',
          'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        ];
    }

    // Debe coincidir con las reglas de Firestore y con src/domain/adjuntos.ts
    match /adjuntos/{colaborador}/{modulo}/{registro}/{archivo} {
      allow read: if puedeLeer();
      allow create: if puedeCapturar()
        && modulo in ['accidentes', 'capacitaciones']
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && tipoPermitido();
      allow update: if false;
      allow delete: if puedeCapturar();
    }
  }
}
