{
  "name": "seguridad-higiene",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "limpiar:entregas": "node --env-file=.env.local scripts/limpiar-entregas.mjs",
    "config:firebase": "node --env-file=.env.local scripts/generar-config-firebase.mjs",
    "verificar:publicable": "node scripts/verificar-publicable.mjs",
    "verificar:historial": "node scripts/verificar-publicable.mjs --historial",
    "test:rules": "firebase emulators:exec --config firebase.test.json --only firestore,storage --project demo-seguridad-higiene \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.1.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.32.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
